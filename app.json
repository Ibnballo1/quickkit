{
  "expo": {
    "name": "QuickKit",
    "slug": "quickkit",
    "scheme": "quickkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ibnballo.quickkit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-system-ui",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QuickKit uses the camera to scan QR codes. Nothing is uploaded or stored off your device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuickKit needs access to your photos so you can pick an image to compress or resize."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "QuickKit saves your compressed and resized images to your photo library.",
          "savePhotosPermission": "QuickKit saves your compressed and resized images to your photo library."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0d6c740-6aba-4e7e-b1f5-9ef293bf6d76"
      }
    }
  }
}
